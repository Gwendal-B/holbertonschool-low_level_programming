#include "main.h"
#include <stdio.h>

/**
 * _strstr - localise une sous-chaine dans une chaîne
 * @haystack: chaine principale
 * @needle: sous-chaine a trouver
 *
 * Return: pointeur vers le debut de la sous-chaine trouver, ou NULL
 */
char *_strstr(char *haystack, char *needle)
{
    int i, j;

    if (*needle == '\0')
        return (haystack);

    for (i = 0; haystack[i] != '\0'; i++)
    {
        for (j = 0; needle[j] != '\0'; j++)
        {
            if (haystack[i + j] != needle[j])
                break;
        }

        if (needle[j] == '\0')
            return (&haystack[i]);
    }

    return (NULL);
}
